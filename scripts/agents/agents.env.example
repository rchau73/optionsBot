# agents.env — the agents' share of your Claude plan (limit_lib.sh "Budget").
# Copy to <envs>/agents.env (~/dev/go/optionsBot-env/agents.env): outside both
# clones, so a deploy never resets it. Read at every tick: edits apply within
# 6 minutes, no reinstall. A variable set in the environment wins.

# 1 = no new Claude run (deploys and the PR gate keep running; runs already
# going finish).
AGENTS_PAUSED=0

# Local hours a Claude run may start in, from-to (wraps midnight). Empty or
# 0-24 = any hour. 20-8: evenings and nights, the day stays free for you.
AGENT_HOURS=20-8

# Claude runs started per local day, all agents together (Dev, Review, PM,
# PM answers, SME). A Dev run is the largest; a review or triage is smaller.
AGENT_MAX_RUNS_PER_DAY=20

# Instances at once (each 1 by default).
DEV_PARALLEL=1
REVIEW_PARALLEL=1
PM_ANSWER_PARALLEL=1

# Models (empty = the account default). sonnet uses far less of the plan.
# Dev: unless DEV_MODEL is set, documents/research cards (label documentation,
# or an epic below) use DEV_LIGHT_MODEL; code cards use the default.
DEV_LIGHT_MODEL=sonnet
DEV_LIGHT_EPICS=E5,E11
#DEV_MODEL=sonnet
#REVIEW_MODEL=sonnet
#PM_MODEL=sonnet
#SME_MODEL=sonnet
