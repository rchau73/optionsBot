flowchart TD
    subgraph START["Start (once)"]
        A["public/get_instruments<br/>strike · expiry · tick steps · min lot"] --> B["public/get_volatility_index_data<br/>seed 1 year of daily DVOL"]
        B --> C["selectRelevantExpiries<br/>per slot: NearestExpiry in ExpiryWindow<br/>(same rule as the strategy, rollout_dte floor)<br/>+ next 3 expiries for rollouts"]
        C --> D["Subscribe: deribit_volatility_index.btc_usd<br/>deribit_price_index.btc_usd<br/>ticker.INSTRUMENT.100ms for relevant expiries"]
        D --> E["go processNotifications"]
    end
    subgraph PUSH["processNotifications"]
        F["gateway Notifications()"] --> G{"channel prefix"}
        G -- "deribit_volatility_index." --> H["DVOLTracker.Record(now, value)<br/>one value per UTC day"]
        G -- "deribit_price_index." --> I["underlyingPrice = price"]
        G -- "ticker." --> J["update instrument:<br/>bid · ask · mid (mark if no quotes)<br/>greeks · IV · DVOL · IV percentile"]
    end
    subgraph READ["Readers (strategy, GEX)"]
        K["GetInstrument / AllInstruments → copies<br/>UnderlyingPrice · IVPercentile"]
    end
    J --> K
    I --> K
    H --> K
