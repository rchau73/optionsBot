flowchart TD
    subgraph STARTUP["Start — called once at bot init"]
        A[public/get_instruments\ncurrency=BTC kind=option] --> B[Parse 1040+ instruments\nname · strike · expiry\nticSize · minTradeAmount]
        B --> C[selectRelevantExpiries\ntargetDTE ± maxDTEDeviation\n+ next 3 future expiries for rollout]
        C --> D{For each instrument}
        D -->|"expiry in relevant set"| E[Add ticker.INST.100ms\nto channels list]
        D -->|"not relevant → skip"| D
        E --> F[Subscribe DVOL channel]
        F --> G[gw.Subscribe\nbatches of 50\n~200-600 channels instead of 1041]
        G --> H[go processNotifications]
    end

    subgraph NOTIFICATIONS["processNotifications — goroutine"]
        I[gw.Notifications] --> J{channel prefix?}
        J -->|"deribit_volatility_index.*"| K[dvol.Push volatility\nrolling 252-day history]
        J -->|"ticker.*"| L[handleTicker]
        J -->|"other"| I
    end

    subgraph TICKER["handleTicker"]
        L --> M[Unmarshal bid/ask\nunderlyingPrice\ngreeks delta/gamma/theta/vega/rho\nmarkIV]
        M --> N{instrument\nin cache?}
        N -->|"No"| I
        N -->|"Yes"| O[Update cache\nbid · ask\nmid = bid+ask/2\ngreeks · IV = markIV/100\ndvolIndex · ivPercentile\nupdatedAt]
        O --> P[Emit Tick to tickCh]
        P --> Q([Strategy onTick])
    end

    subgraph DVOL["DVOLTracker"]
        K --> R[Append value\ntrim to window=252]
        R --> S[percentile =\ncount below current\n÷ n-1 × 100]
        S --> T{Band}
        T -->|"≥ 70"| U[35% margin]
        T -->|"30–69"| V[25% margin]
        T -->|"< 30"| W[15% margin]
    end
