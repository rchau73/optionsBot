flowchart TB
    subgraph EXT["External"]
        DERIBIT["Deribit JSON-RPC over WebSocket<br/>testnet by default · live only with DERIBIT_ENV=live"]
        FILES["Files<br/>bot.log · orders.log · hedge_report.json"]
        HIST["data/historical/options.csv"]
    end

    MAIN["cmd/bot/main.go — composition root<br/>flags · logger · config · wiring · SIGUSR1 → KillSwitch"]
    CFG["internal/config<br/>config.yaml = strategy logic · .env = platform<br/>Validate() on load"]

    subgraph GW["internal/gateway — the only connection to Deribit"]
        PQ["PriorityQueue<br/>high: stop-loss · kill · GEX close<br/>low: everything else"]
        RL["RateLimiter<br/>matching-engine pool · non-matching pool"]
        CB["CircuitBreaker<br/>exchange-health errors only<br/>high priority bypasses"]
        RD["readLoop: routes replies by ID<br/>pushes → Notifications()"]
        RC["reconnect + re-subscribe<br/>Fatal() when it gives up"]
    end

    subgraph MD["internal/marketdata"]
        MDM["Manager<br/>option chain · ticker / index / DVOL pushes"]
        EXP["ExpiryWindow · NearestExpiry<br/>(shared with strategy)"]
        DV["DVOLTracker<br/>one value per day → IV percentile"]
    end

    GEX["internal/gex<br/>Manager polls OI every 60 s<br/>flip-based regime + hysteresis"]

    subgraph ST["internal/strategy — decision loop"]
        DEPS["deps.go: consumer interfaces<br/>OrderPlacer · OrderTracker · AccountReader<br/>MarketData · TradeJournal · HedgeReporter · GEXSource"]
        LOOP["strategy.go: Run / evaluate / heartbeat"]
        OPEN["open.go + pending.go<br/>entry · fill tracking · amend · timeout"]
        CLOSE["close.go: buyToClose<br/>stop-loss · roll · GEX close"]
        REP["repair.go · reconcile.go · rebalance.go · killswitch.go"]
        PURE["pure rules: entry.go · rollout.go · gamma.go · margin.go"]
    end

    subgraph ORD["internal/orders"]
        EX["Executor<br/>Deribit order + account calls"]
        SM["StateManager<br/>in-memory book · snapshots"]
        OL["Logger → orders.log"]
    end

    HG["internal/hedge<br/>Reporter — report only, never trades"]

    subgraph BT["internal/backtest"]
        FEED["HistoricalFeed"] --> ENG["Engine (day loop)"]
        ENG --> SIM["SimExecutor"]
        ENG --> RES["ResultWriter · sweep · walk-forward"]
    end

    MAIN --> CFG
    MAIN --> GW
    MAIN --> MD
    MAIN --> GEX
    MAIN --> ST
    MAIN -. "--mode=backtest" .-> BT

    DERIBIT <--> GW
    GW --> MDM
    GEX --> GW
    GEX --> MDM
    EX --> GW

    LOOP --> OPEN
    LOOP --> CLOSE
    LOOP --> REP
    OPEN --> PURE
    CLOSE --> PURE
    DEPS -. "implemented by" .-> EX
    DEPS -. "implemented by" .-> MDM
    DEPS -. "implemented by" .-> OL
    DEPS -. "implemented by" .-> HG
    DEPS -. "implemented by" .-> GEX
    ST --> SM

    OL --> FILES
    HG --> FILES
    HIST --> FEED
    ENG --> PURE
    ENG --> SM

    classDef ext fill:#e8f4f8,stroke:#2196F3,color:#000
    classDef gw fill:#fff3e0,stroke:#FF9800,color:#000
    classDef md fill:#e8f5e9,stroke:#4CAF50,color:#000
    classDef st fill:#fce4ec,stroke:#E91E63,color:#000
    classDef ord fill:#f3e5f5,stroke:#9C27B0,color:#000
    classDef bt fill:#e3f2fd,stroke:#1565C0,color:#000
    class DERIBIT,FILES,HIST ext
    class PQ,RL,CB,RD,RC gw
    class MDM,EXP,DV,GEX md
    class DEPS,LOOP,OPEN,CLOSE,REP,PURE st
    class EX,SM,OL,HG ord
    class FEED,ENG,SIM,RES bt
