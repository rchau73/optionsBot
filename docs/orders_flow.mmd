flowchart TD
    subgraph EXECUTOR["Executor — live order placement"]
        A([Strategy\nOrder request]) --> B{Direction?}
        B -->|"Sell"| C[private/sell via Gateway]
        B -->|"Buy"| D[private/buy via Gateway]
        C --> E{TriggerReason\nstop-loss / kill / gamma?}
        D --> E
        E -->|"Yes"| F[PriorityHigh Queue]
        E -->|"No"| G[PriorityLow Queue]
        F --> H[Deribit API\nreturns order_id\navg_price · filled_amount]
        G --> H
        H --> I[Fill\norderID · fillPrice\nqty · timestamp]
    end

    subgraph STATE["StateManager — in-memory"]
        I --> J[AddPosition or update]
        J --> K[(positions map)]
        J --> L[(strangles map)]
        K --> M[NetGamma = Σ gamma×qty]
        K --> N[TotalNetDelta = Σ delta×qty]
        K --> O[TotalMarginUsed = Σ mid×qty]
    end

    subgraph LOGGER["OrderLogger — JSON audit trail"]
        I --> P[buildRecord\nFill + Position + Greeks snapshot]
        P --> Q[Derived fields\nintrinsic = max underl-strike, 0\nextrinsic = price - intrinsic\nspread_pct = spread/mid × 100]
        Q --> R{Closing\ntransaction?}
        R -->|"Yes"| S[ROI fields\npnl = premium - close_cost\nroi_pct = pnl/premium × 100\nroi_annualized = roi/days × 365]
        R -->|"No"| T[omit ROI fields]
        S --> U[JSON line → orders.log]
        T --> U
    end

    Q --> V{spread_pct >\nspreadAlertThreshold 5%?}
    V -->|"Yes"| W[WARN wide spread alert\nin bot.log]
