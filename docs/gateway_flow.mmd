flowchart TD
    A([Caller\nstrategy / marketdata / orders]) -->|"Call(ctx, method, params, priority)"| B{Priority?}
    B -->|"High\nstop-loss · kill · gamma close"| C[High Channel buf=64]
    B -->|"Low\nmarket data · subscriptions"| D[Low Channel buf=256]

    subgraph DISPATCH["Dispatch Loop — goroutine"]
        E{High channel\nempty?}
        C --> E
        D --> E
        E -->|"No — drain High first"| F[sendRequest]
        E -->|"Yes — take from either"| F
    end

    subgraph SEND["sendRequest"]
        F --> G{Circuit Breaker\nAllow?}
        G -->|"Open → blocked"| H[Return error to caller]
        G -->|"Closed / HalfOpen"| I{Rate Limiter Wait\nHigh→WaitMatch\nLow→WaitNonMatch}
        I --> J[Marshal JSON\nWrite WS frame]
        J --> K{Response within 30s?}
        K -->|"Timeout"| L[cb.Failure]
        K -->|"Error 10028/10040"| M[cb.Failure\nretryCount++]
        K -->|"Success"| N[cb.Success\ndeliver to caller]
        M --> O{Max retries?}
        O -->|"No"| P[Sleep full jitter\n0..backoff ms]
        P --> I
        O -->|"Yes"| Q[Return max retries exceeded]
    end

    subgraph READLOOP["Read Loop — goroutine"]
        R[WS ReadMessage] --> S{Push or Response?}
        S -->|"Method set → notification"| T[notifyCh buf=4096]
        S -->|"ID set → response"| U[pending map → respCh]
        U --> K
        R -->|"WS error"| V[go reconnect]
    end

    subgraph RECONNECT["Reconnect — goroutine once at a time"]
        V --> W[subs.All → subs.Clear]
        W --> X[DialContext + auth\nrestart goroutines]
        X -->|"success"| Y[re-Subscribe\nrestored channels]
        X -->|"fail + exp backoff"| X
    end

    T -->|"Tick / DVOL events"| AA([MarketData Manager])
    N -->|"Fill response"| BB([Orders Executor])
