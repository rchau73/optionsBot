flowchart LR
    subgraph BIZ["💼 BUSINESS · what is worth building, and did it pay off?"]
        direction TB
        BOTS[("Testnet bots<br/>BTC · ETH<br/>positions · P&L · margin · journal")]
        SME["<b>① SME agent · daily</b><br/>senior options PM<br/>risk · idle margin · fills · P&L<br/>root cause in the trading rules<br/>business case + acceptance criteria<br/><i>read-only</i>"]
        TRI["② Issue · Triage<br/>cost in coin · USD · days<br/>options + recommendation"]
        PRD["⓪ PRD · epics<br/>product-manager + ux-designer<br/>roadmap · MVP · prototypes"]
        H0(["Human approves<br/>PRD merge · prototype<br/><b>gate 0</b>"])
        PM["<b>③ PM agent · 15 min</b><br/>senior product manager<br/>one epic per ticket · priority<br/>Ready only if the PRD covers it<br/><i>read-only</i>"]
        H1(["Human decides<br/>the rest · <b>gate 1</b>"])
    end

    subgraph ENG["⚙️ ENGINEERING DELIVERY · build it right"]
        direction LR
        READY["④ Ready"]
        DEV["⑤ Dev agent · 15 min<br/>developer skill<br/>edit · test · commit"]
        PR["⑥ PR · In review<br/>checks re-run · CI"]
        REV["⑦ Reviewer agent · 15 min<br/>developer skill · Review mode<br/><b>read-only</b> · verified findings"]
        H2(["⑧ Human reviews<br/>& merges · <b>gate 2</b>"])
        DEP["⑨ Deploy · 15 min<br/>testnet only<br/>health check"]
        DONE["⑩ Done"]
        BLK["Blocked<br/>needs-human"]
    end

    PRD ==> H0 ==>|approved epics| PM
    BOTS ==> SME ==> TRI ==> PM ==>|"approved epic · rule area covered<br/>· prototype approved"| READY
    PM -->|outside the PRD| H1 --> READY
    READY --> DEV --> PR --> REV -->|no blocking finding| H2 --> DEP --> DONE
    REV ==>|"🛑 blocking finding (bug): review posted + card back to Ready<br/>Dev fixes on the same PR · ≤ 2 rounds"| READY
    DEP -->|restart| BOTS
    DEV -.->|questions /<br/>failing checks| BLK -.->|answered| READY
    DONE ==>|"⑪ SME verifies the outcome on live data;<br/>reopens if not fixed"| SME

    classDef sme fill:#fff8e1,stroke:#f9a825,color:#000,stroke-width:5px
    classDef agent fill:#ede7f6,stroke:#5e35b1,color:#000
    classDef human fill:#fff3e0,stroke:#ef6c00,color:#000,stroke-width:2px
    classDef gh fill:#e3f2fd,stroke:#1565c0,color:#000
    classDef run fill:#e8f5e9,stroke:#2e7d32,color:#000
    class SME,PM sme
    class DEV,REV,DEP agent
    class H0,H1,H2 human
    class PRD,TRI,READY,PR,DONE,BLK gh
    class BOTS run
    style BIZ fill:#fffdf3,stroke:#f9a825,stroke-width:3px
    style ENG fill:#fafafa,stroke:#9e9e9e,stroke-width:1px,stroke-dasharray:4 3
