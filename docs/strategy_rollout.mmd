flowchart TD
    A(["EvaluateLeg(pos, now, …)"]) --> B{"loss ≥ stop_loss_multiplier<br/>× premium received?"}
    B -- "yes" --> C["ActionStopLoss<br/>buy MARKET, high priority<br/>partial fill → remainder stays tracked"]
    B -- "no" --> D{"DTE ≤ rollout_dte?"}
    D -- "yes" --> E["ActionRollNextMonth<br/>close leg: IOC limit at ask<br/>both legs closed → slot freed → fresh entry"]
    D -- "no" --> F{"|delta| < delta_drift_threshold<br/>and DTE ≥ 25?"}
    F -- "yes" --> G["ActionRollSameLeg (delta drift)<br/>close leg: IOC limit at ask<br/>repair reopens at entry delta, same expiry"]
    F -- "no" --> H{"ROI ≥ roi_take_profit<br/>and DTE ≥ 25?"}
    H -- "yes" --> I["ActionRollSameLeg (take profit)<br/>close leg: IOC limit at ask<br/>repair reopens at entry delta, same expiry"]
    H -- "no" --> J["ActionNone — keep holding"]
    style C fill:#ffcdd2,stroke:#c62828,color:#000
    style E fill:#fff9c4,stroke:#f9a825,color:#000
    style G fill:#e8f5e9,stroke:#2e7d32,color:#000
    style I fill:#e3f2fd,stroke:#1565c0,color:#000
    style J fill:#f5f5f5,stroke:#9e9e9e,color:#000
