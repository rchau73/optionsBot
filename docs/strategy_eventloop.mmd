    E2 --> E3["checkPendingOrders<br/>fills · amend on drift · timeout → keep filled legs"]
    E3 --> E4{"GammaDecision.Action"}
    E4 -- "ClosePuts / CloseCalls" --> E5["handleGammaAction: buyToClose at market"]
    E4 -- "None" --> E6
    E5 --> E6["EvaluateLeg per position → handleRollout<br/>(stop-loss · DTE roll · delta drift · ROI)"]
