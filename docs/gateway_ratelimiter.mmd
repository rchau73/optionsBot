    subgraph POOLS["Token buckets (golang.org/x/time/rate), burst 1"]
        B1["non-matching pool<br/>20 × 0.80 = 16 req/s<br/>auth · subscribe · tickers · account · margins · OI"]
        B2["matching-engine pool<br/>8 × 0.80 = 6.4 req/s<br/>private/buy · sell · edit · cancel*"]
