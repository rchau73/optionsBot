# ── Deribit Credentials ───────────────────────────────────────────────────────
DERIBIT_CLIENT_ID=your_client_id
DERIBIT_CLIENT_SECRET=your_client_secret
DERIBIT_ENV=testnet                    # testnet | live

# ── WebSocket Rate Limits ─────────────────────────────────────────────────────
# Match the limits shown in your Deribit account settings.
DERIBIT_RATE_WS_NONMATCH_RPS=20
DERIBIT_RATE_WS_MATCH_RPS=8
DERIBIT_RATE_MAX_SUBSCRIPTIONS=1000
DERIBIT_RATE_SAFETY_FACTOR=0.50       # bot uses at most this fraction of each limit

# ── Retry & Backoff ───────────────────────────────────────────────────────────
DERIBIT_BACKOFF_INITIAL_MS=500
DERIBIT_BACKOFF_MULTIPLIER=2.0
DERIBIT_BACKOFF_MAX_MS=30000
DERIBIT_BACKOFF_MAX_RETRIES=6

# ── Circuit Breaker ───────────────────────────────────────────────────────────
DERIBIT_CIRCUIT_BREAKER_THRESHOLD=5
DERIBIT_CIRCUIT_BREAKER_OPEN_SEC=60

# ── Heartbeat & Reconnect ─────────────────────────────────────────────────────
DERIBIT_HEARTBEAT_INTERVAL_SEC=15
DERIBIT_RECONNECT_MAX_ATTEMPTS=10
DERIBIT_RECONNECT_BACKOFF_BASE_MS=1000

# ── Monitor API (read-only, for the frontend) ────────────────────────────────
# Empty = off. Local runs: 127.0.0.1:8081. docker-compose sets it per service.
BOT_API_ADDR=
# Account/collateral summary for the monitor: one read-only call every N seconds.
BOT_ACCOUNT_POLL_SEC=10
