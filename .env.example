# ── Deribit Credentials ───────────────────────────────────────────────────────
DERIBIT_CLIENT_ID=your_client_id
DERIBIT_CLIENT_SECRET=your_client_secret
DERIBIT_ENV=testnet                    # testnet | live

# ── WebSocket Rate Limits ─────────────────────────────────────────────────────
# Match the limits shown in your Deribit account settings.
DERIBIT_RATE_WS_NONMATCH_RPS=20
DERIBIT_RATE_WS_MATCH_RPS=8
DERIBIT_RATE_MAX_SUBSCRIPTIONS=1000
DERIBIT_RATE_SAFETY_FACTOR=0.50       # bot uses at most this fraction of each limit

# ── Retry & Backoff ───────────────────────────────────────────────────────────
DERIBIT_BACKOFF_INITIAL_MS=500
DERIBIT_BACKOFF_MULTIPLIER=2.0
DERIBIT_BACKOFF_MAX_MS=30000
DERIBIT_BACKOFF_MAX_RETRIES=6

# ── Circuit Breaker ───────────────────────────────────────────────────────────
DERIBIT_CIRCUIT_BREAKER_THRESHOLD=5
DERIBIT_CIRCUIT_BREAKER_OPEN_SEC=60

# ── Heartbeat & Reconnect ─────────────────────────────────────────────────────
DERIBIT_HEARTBEAT_INTERVAL_SEC=15
DERIBIT_RECONNECT_MAX_ATTEMPTS=10
DERIBIT_RECONNECT_BACKOFF_BASE_MS=1000

# ── Monitor API (read-only, for the frontend) ────────────────────────────────
# Empty = off. Local runs: 127.0.0.1:8081. docker-compose sets it per service.
BOT_API_ADDR=
# Account/collateral summary for the monitor: one read-only call every N seconds.
BOT_ACCOUNT_POLL_SEC=10
# Manual close from the monitor (POST /api/positions/close): a long random
# secret shared with the monitor (docker-compose passes it on). Empty = off.
# Testnet only; the bot allows it only for a leg under the regime-side block.
BOT_ADMIN_TOKEN=

# ── Monitor sign-in (frontend/README.md "Sign-in") ───────────────────────────
# Each environment's own values; never commit them. The monitor refuses to
# start without AUTH_SECRET: at least 32 random bytes (openssl rand -base64 48).
AUTH_SECRET=
# First admin, created only while there are no users (password ≥ 12 chars).
# Clear ADMIN_PASSWORD from .env once you have signed in.
ADMIN_USERNAME=
ADMIN_PASSWORD=
ADMIN_EMAIL=
# Analytics (docs/product/analytics/event-plan.md, #193): salt of the
# pseudonymous user id in data/monitor/events.jsonl, ≥ 16 chars
# (openssl rand -hex 32). Empty = the monitor collects no event.
ANALYTICS_SALT=
# Help assistant (#191, frontend/README.md "Assistant"): the monitor's Claude
# API key, written by the person (console.anthropic.com; API billing is separate
# from a Claude subscription). Empty = POST /api/assistant answers 503.
ANTHROPIC_API_KEY=
# The assistant's model; empty = claude-haiku-5-5 (#412).
ASSISTANT_MODEL=
# Read-only token (≥ 32 chars) for the deploy health check and the agents:
# GET /api/bots/* without a session. Empty = scripts can't read the monitor.
MONITOR_API_TOKEN=
