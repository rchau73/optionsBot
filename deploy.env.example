# deploy.env — one per environment clone (scripts/envctl.sh <stable|mvp> init
# writes it; docs/operations.md "Environments"). Not secret: no key goes here,
# the Deribit keys live in the clone's .env. This is mvp's; stable has
# MONITOR_PORT=3000, BOT_RECORD_MARKET=1, no BOT_CONFIG_BTC and BOT_LINEAR=0.
OPTIONSBOT_ENV=mvp
MONITOR_PORT=3100
BOT_RECORD_MARKET=0
# mvp's BTC bot reads its direction from the SMA trend (#168).
BOT_CONFIG_BTC=./config_btc.mvp.yaml
# The SOL and XRP bots (#837): 1 starts bot-sol and bot-xrp (compose profile
# "linear") and lists them on the monitor. Each needs its OWN testnet account:
# SOL_DERIBIT_CLIENT_ID/_SECRET and XRP_DERIBIT_CLIENT_ID/_SECRET in .env,
# or env_check refuses to start. 0 or absent: BTC and ETH only.
BOT_LINEAR=1
